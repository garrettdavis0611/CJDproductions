# Copy to .env and fill in. Never commit .env.

# --- optional: higher rate limits ------------------------------------------
# JUPITER_API_KEY=            # https://portal.jup.ag ; switches to api.jup.ag
# RUGCHECK_API_KEY=

# --- copy trading ----------------------------------------------------------
# Only needed for smart_money.feed: birdeye. The default 'rpc' feed needs no key,
# but reconstructs trades one getTransaction at a time — use a paid RPC for it.
# BIRDEYE_API_KEY=

# --- strongly recommended for live trading ---------------------------------
# The public RPC is rate limited and will fail you at the worst moment.
# MEMEBOT_SOLANA_RPC_URL=https://your-paid-rpc-endpoint

# --- live trading (leave unset for paper) ----------------------------------
# Both of these are required before a single lamport moves.
#
# Use a BURNER wallet. Fund it with only what you are prepared to lose entirely.
# Never put a seed phrase or a main-wallet key here.
# SOLANA_PRIVATE_KEY=         # base58, or a JSON byte array like [12,34,...]
# MEMEBOT_I_UNDERSTAND_THE_RISK=1

# --- config overrides ------------------------------------------------------
# MEMEBOT_MODE=paper
# MEMEBOT_STARTING_EQUITY_USD=1000
# MEMEBOT_MAX_POSITION_USD=100
# MEMEBOT_LIVE_MAX_TRADE_USD=10
# MEMEBOT_POLL_SECONDS=30
# MEMEBOT_LOG_LEVEL=INFO
# MEMEBOT_DATA_DIR=data
